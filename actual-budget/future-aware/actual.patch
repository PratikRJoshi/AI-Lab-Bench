+export function createFutureCommitments(months: string[]): void {
+  const sorted = [...months].sort();
+  for (let index = sorted.length - 1; index >= 0; index--) {
+    const sheetName = monthUtils.sheetForMonth(sorted[index]);
+    const next = sorted[index + 1];
+    const nextSheet = next && monthUtils.sheetForMonth(next);
+
+    // A new month changes the former final month's dependencies. Dynamic
+    // cells otherwise retain their old links when createDynamic is called.
+    sheet.get().voidCell(sheetName, 'future-commitments');
+    sheet.get().createDynamic(sheetName, 'future-commitments', {
+      initialValue: 0,
+      dependencies: nextSheet
+        ? [
+            `${nextSheet}!total-budgeted`,
+            `${nextSheet}!buffered`,
+            `${nextSheet}!future-commitments`,
+          ]
+        : [],
+      run: (budgeted, manualHold, laterCommitment) =>
+        safeNumber(
+          Math.max(
+            0,
+            -number(budgeted) +
+              Math.max(number(manualHold), number(laterCommitment)),
+          ),
+        ),
+    });
+  }
+}
