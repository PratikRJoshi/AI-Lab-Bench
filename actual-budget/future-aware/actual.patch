+import { beforeEach, describe, expect, it } from 'vitest';
+
+import * as db from '#server/db';
+import * as sheet from '#server/sheet';
+
+import { holdForNextMonth, setBudget, setBuffer } from './actions';
+import { createAllBudgets, createBudget } from './base';
+
+async function setupMonths(months = ['2026-11', '2026-12', '2027-01']) {
+  await db.insertCategoryGroup({
+    id: 'income-group',
+    name: 'Income',
+    is_income: 1,
+  });
+  await db.insertCategory({
+    id: 'income',
+    name: 'Income',
+    cat_group: 'income-group',
+    is_income: 1,
+  });
+  await db.insertCategoryGroup({ id: 'expenses', name: 'Expenses' });
+  await db.insertCategory({
+    id: 'groceries',
+    name: 'Groceries',
+    cat_group: 'expenses',
+  });
+  await db.insertAccount({ id: 'checking', name: 'Checking' });
+  await sheet.loadSpreadsheet(db);
+  await createBudget(months);
+  await db.insertTransaction({
+    account: 'checking',
+    category: 'income',
+    date: '2026-11-01',
+    amount: 10000,
+  });
+  await sheet.waitOnSpreadsheet();
+}
+
+describe('future assignments', () => {
+  beforeEach(global.emptyDatabase());
+
+  it('reserves money already assigned next month without writing a hold or changing category balances', async () => {
+    await setupMonths();
+    await setBudget({ month: '2026-12', category: 'groceries', amount: 10000 });
+    await sheet.waitOnSpreadsheet();
+
+    expect(sheet.getCellValue('budget202611', 'to-budget')).toBe(0);
+    expect(sheet.getCellValue('budget202611', 'buffered-selected')).toBe(10000);
+    expect(sheet.getCellValue('budget202612', 'to-budget')).toBe(0);
+    expect(sheet.getCellValue('budget202612', 'leftover-groceries')).toBe(
+      10000,
+    );
+    expect(await db.all('SELECT * FROM zero_budget_months')).toEqual([]);
+    expect(
+      await db.all('SELECT month, amount FROM zero_budgets ORDER BY month'),
+    ).toEqual([{ month: 202612, amount: 10000 }]);
+  });
+
+  it('releases the reservation when a later assignment is removed', async () => {
+    await setupMonths();
+    await setBudget({ month: '2026-12', category: 'groceries', amount: 10000 });
+    await sheet.waitOnSpreadsheet();
+    await setBudget({ month: '2026-12', category: 'groceries', amount: 0 });
+    await sheet.waitOnSpreadsheet();
+    expect(sheet.getCellValue('budget202611', 'to-budget')).toBe(10000);
+    expect(sheet.getCellValue('budget202611', 'buffered-selected')).toBe(0);
+  });
+
+  it('reserves multiple later assignments across a year boundary once', async () => {
+    await setupMonths();
+    await setBudget({ month: '2026-12', category: 'groceries', amount: 6000 });
+    await setBudget({ month: '2027-01', category: 'groceries', amount: 4000 });
+    await sheet.waitOnSpreadsheet();
+    expect(sheet.getCellValue('budget202611', 'to-budget')).toBe(0);
+    expect(sheet.getCellValue('budget202612', 'to-budget')).toBe(0);
+    expect(sheet.getCellValue('budget202612', 'buffered-selected')).toBe(4000);
+    expect(sheet.getCellValue('budget202701', 'to-budget')).toBe(0);
+    expect(sheet.getCellValue('budget202701', 'leftover-groceries')).toBe(
+      10000,
+    );
+  });
+
+  it('does not use a later negative assignment to fund an earlier month', async () => {
+    await setupMonths();
+    await setBudget({ month: '2026-12', category: 'groceries', amount: 10000 });
+    await setBudget({
+      month: '2027-01',
+      category: 'groceries',
+      amount: -10000,
+    });
+    await sheet.waitOnSpreadsheet();
+    expect(sheet.getCellValue('budget202611', 'to-budget')).toBe(0);
+    expect(sheet.getCellValue('budget202612', 'to-budget')).toBe(0);
+    expect(sheet.getCellValue('budget202701', 'to-budget')).toBe(10000);
+  });
+
+  it.each([4000, 10000])(
+    'overlaps a manual hold of %i with future assignments',
+    async amount => {
+      await setupMonths();
+      await setBuffer('2026-11', amount);
+      await setBudget({
+        month: '2026-12',
+        category: 'groceries',
+        amount: 10000,
+      });
+      await sheet.waitOnSpreadsheet();
+      expect(sheet.getCellValue('budget202611', 'to-budget')).toBe(0);
+      expect(sheet.getCellValue('budget202611', 'buffered-selected')).toBe(
+        10000,
+      );
+      expect(sheet.getCellValue('budget202612', 'to-budget')).toBe(0);
+      expect(
+        (
+          await db.first<{ buffered: number }>(
+            'SELECT buffered FROM zero_budget_months WHERE id=?',
+            ['2026-11'],
+          )
+        )?.buffered,
+      ).toBe(amount);
+    },
+  );
+
+  it('holds an additional amount above the existing future reservation', async () => {
+    await setupMonths();
+    await setBudget({ month: '2026-12', category: 'groceries', amount: 6000 });
+    await sheet.waitOnSpreadsheet();
+    expect(sheet.getCellValue('budget202611', 'to-budget')).toBe(4000);
+    await holdForNextMonth({ month: '2026-11', amount: 4000 });
+    await sheet.waitOnSpreadsheet();
+    expect(sheet.getCellValue('budget202611', 'to-budget')).toBe(0);
+    expect(sheet.getCellValue('budget202611', 'buffered-selected')).toBe(10000);
+    expect(sheet.getCellValue('budget202612', 'to-budget')).toBe(4000);
+  });
+
+  it('shows a shortfall in the future month instead of inventing current money', async () => {
+    await setupMonths();
+    await setBudget({ month: '2026-12', category: 'groceries', amount: 15000 });
+    await sheet.waitOnSpreadsheet();
+    expect(sheet.getCellValue('budget202611', 'to-budget')).toBe(0);
+    expect(sheet.getCellValue('budget202611', 'buffered-selected')).toBe(10000);
+    expect(sheet.getCellValue('budget202612', 'to-budget')).toBe(-5000);
+  });
+
+  it('does not make future income available in the current month', async () => {
+    await setupMonths();
+    await db.insertTransaction({
+      account: 'checking',
+      category: 'income',
+      date: '2026-12-01',
+      amount: 100000,
+    });
+    await setBudget({ month: '2026-12', category: 'groceries', amount: 20000 });
+    await sheet.waitOnSpreadsheet();
+    expect(sheet.getCellValue('budget202611', 'buffered-selected')).toBe(10000);
+    expect(sheet.getCellValue('budget202611', 'to-budget')).toBe(0);
+    expect(sheet.getCellValue('budget202612', 'to-budget')).toBe(90000);
+  });
+
+  it('does not reserve current cash just because future income is held', async () => {
+    await setupMonths();
+    await db.insert('zero_budgets', {
+      id: '202612-income',
+      month: 202612,
+      category: 'income',
+      carryover: 1,
+    });
+    await db.insertTransaction({
+      account: 'checking',
+      category: 'income',
+      date: '2026-12-01',
+      amount: 10000,
+    });
+    await sheet.waitOnSpreadsheet();
+    expect(sheet.getCellValue('budget202611', 'to-budget')).toBe(10000);
+    expect(sheet.getCellValue('budget202612', 'buffered-auto')).toBe(10000);
+  });
+
+  it('preserves a negative income hold when no future assignments exist', async () => {
+    await setupMonths();
+    await db.insert('zero_budgets', {
+      id: '202611-income',
+      month: 202611,
+      category: 'income',
+      carryover: 1,
+    });
+    await db.insertTransaction({
+      account: 'checking',
+      category: 'income',
+      date: '2026-11-02',
+      amount: -15000,
+    });
+    await sheet.waitOnSpreadsheet();
+    expect(sheet.getCellValue('budget202611', 'buffered-selected')).toBe(-5000);
+    expect(sheet.getCellValue('budget202611', 'to-budget')).toBe(0);
+  });
