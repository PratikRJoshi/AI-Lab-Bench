+import { render, screen } from '@testing-library/react';
+
+import { SheetNameProvider } from '#hooks/useSheetName';
+import { TestProviders } from '#mocks';
+
+import { ToBudgetMenu } from './ToBudgetMenu';
+
+vi.mock(
+  '@actual-app/core/platform/client/connection',
+  () => import('#mocks/connection'),
+);
+
+let sheetValues: Record<string, number>;
+
+vi.mock('#hooks/useSheetValue', async () => {
+  const { useSheetName } = await import('#hooks/useSheetName');
+  return {
+    useSheetValue: (binding: Parameters<typeof useSheetName>[0]) => {
+      const { fullSheetName } = useSheetName(binding);
+      return sheetValues[fullSheetName] ?? 0;
+    },
+  };
+});
+
+function renderMenu() {
+  render(
+    <TestProviders>
+      <SheetNameProvider name="budget202611">
+        <ToBudgetMenu
+          month="2026-11"
+          onTransfer={vi.fn()}
+          onCover={vi.fn()}
+          onHoldBuffer={vi.fn()}
+          onResetHoldBuffer={vi.fn()}
+        />
+      </SheetNameProvider>
+    </TestProviders>,
+  );
+}
+
+describe('ToBudgetMenu automatic reservations', () => {
+  beforeEach(() => {
+    sheetValues = {
+      'budget202611!to-budget': 0,
+      'budget202611!buffered-selected': 10000,
+      'budget202611!buffered': 0,
+      'budget202611!buffered-auto': 0,
+    };
+  });
+
+  it('does not offer to disable an income hold for future assignments alone', async () => {
+    renderMenu();
+    expect(await screen.findByText('No actions available')).toBeInTheDocument();
+    expect(
+      screen.queryByText('Disable current auto hold'),
+    ).not.toBeInTheDocument();
+  });
+
+  it('still allows an income-based automatic hold to be disabled', async () => {
+    sheetValues['budget202611!buffered-auto'] = 10000;
+    renderMenu();
+    expect(
+      await screen.findByText('Disable current auto hold'),
+    ).toBeInTheDocument();
+  });
+
+  it('still allows an explicit manual hold to be reset', async () => {
+    sheetValues['budget202611!buffered'] = 10000;
+    renderMenu();
+    expect(
+      await screen.findByText("Reset next month's buffer"),
+    ).toBeInTheDocument();
+  });
+});
