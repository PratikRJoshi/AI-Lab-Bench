{
  "manifest_version": 2,
  "name": "Truth Analyzer",
  "version": "1.0.0",
  "description": "Analyze any social media post for scientific accuracy with one click.",
  "browser_specific_settings": {
    "gecko": {
      "id": "truth-analyzer@pratikjoshi.local",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "notifications",
    "tabs",
    "http://localhost:5757/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Analyze this page with Truth Analyzer"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
