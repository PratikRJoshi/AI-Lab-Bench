# ─────────────────────────────────────────────
# Truth Analyzer — Backend Configuration
# Copy this file to .env and fill in your keys.
# ─────────────────────────────────────────────

# ── LLM (pick one path) ──────────────────────

# Path A: Anthropic API key (preferred — faster, reliable)
ANTHROPIC_API_KEY=

# Path B: AWS Bedrock (use your existing AWS credentials — no new account needed)
# Requires: AWS credentials active in your shell session (aws sts get-caller-identity must succeed)
USE_BEDROCK=false
BEDROCK_MODEL=anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_REGION=us-east-1

# Path C: Use the local `claude` CLI (not recommended — hangs in subprocess mode)
USE_CLAUDE_CLI=false

# ── Search (pick one) ─────────────────────────

# Tavily API key — RECOMMENDED (free: 1000 queries/month, no credit card)
# Sign up at: https://tavily.com
TAVILY_API_KEY=

# Brave Search API key (paid, $5/1000 requests with $5 free credit/month)
# Sign up at: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# Leave both blank to skip web search (analysis still works, Claude uses training data only)

# ── Server ────────────────────────────────────

# Port for the local backend server (default: 5757)
PORT=5757

# ── Whisper ───────────────────────────────────

# Whisper model to use: tiny, base, small (default), medium, large
# Larger = more accurate but slower
WHISPER_MODEL=small
