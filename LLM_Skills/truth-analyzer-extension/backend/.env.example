# ─────────────────────────────────────────────
# Truth Analyzer — Backend Configuration
# Copy this file to .env and fill in your keys.
# ─────────────────────────────────────────────
#
# This backend now delegates analysis to the local Claude Code CLI's
# url-truth-analyzer skill. The skill itself handles download, transcription,
# search, and analysis — the backend just forwards the URL and streams output
# back to the browser.
#
# REQUIRED: USE_CLAUDE_CLI=true and `claude` logged in (run it once interactively).
# All other keys below are unused by the new path; they are kept for the legacy
# pipeline (run_analysis in analyzer.py) which is no longer invoked by server.py.

# ── Primary path: local Claude Code CLI ──────
USE_CLAUDE_CLI=true

# ── Server ────────────────────────────────────
PORT=5757

# Maximum number of analyses that may run in parallel. Each job spawns its
# own claude --print + yt-dlp + Whisper, so pick a number your machine can
# handle. The extension shows an OS notification when the limit is hit.
MAX_CONCURRENT_JOBS=3

# When the extension is clicked on a channel/profile home page (e.g. an
# Instagram handle or a YouTube /@channel page), the backend asks the skill
# to enumerate this many of the most-recent posts and analyze each one.
# The skill's hard cap is 25.
CHANNEL_BATCH_SIZE=10

# ── VPN / connectivity resilience ─────────────────────────────────────────
# The analysis runs through the corporate Claude gateway, reachable only on
# VPN. If the VPN drops mid-analysis, the backend pauses, waits (bounded) for
# connectivity to return, then resumes the same Claude session via
# `claude --resume` (best-effort) or re-runs from scratch.
#
# Total seconds to wait for the VPN to come back before giving up on a job.
RESUME_MAX_WAIT=600
# Seconds between connectivity probes while waiting.
RESUME_POLL_INTERVAL=20
# Max resume/retry cycles for a single job before failing.
RESUME_MAX_ATTEMPTS=3
# Seconds of silence from Claude before we probe connectivity. If we're online,
# Claude is just thinking and we keep waiting; if offline, the job pauses. This
# detects a silent VPN stall without waiting out the full analysis timeout.
CLAUDE_IDLE_TIMEOUT=120
# Optional cheap connectivity probe (HEAD/GET). Defaults to ANTHROPIC_BASE_URL
# when set. Leave empty to fall back to a short `claude --print` ping (truer
# test of the real dependency, but costs a small model call per probe). Set
# this to your Claude gateway base URL to make probing instant and free.
CONNECTIVITY_PROBE_URL=
# Stream Claude's full activity (every assistant turn, tool call, and tool
# result) to the UI as a live "detailed activity" feed (behind a toggle on the
# results page). It's a firehose — a channel batch can be a few MB. Set to
# false to disable and keep only the curated progress heartbeats.
STREAM_CLAUDE_ACTIVITY=true

# ── Legacy pipeline only (unused by current server.py) ──────────────────────
# These were used by the old run_analysis pipeline (yt-dlp + Whisper + direct
# LLM call). Left here for reference / future fallback. Safe to ignore.
ANTHROPIC_API_KEY=
USE_BEDROCK=false
BEDROCK_MODEL=anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_REGION=us-east-1
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
WHISPER_MODEL=small
